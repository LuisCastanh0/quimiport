# Ambiente da aplicação: development | test | production
NODE_ENV=development

# HTTP
PORT=3000
HOST=0.0.0.0

# Nível de log do pino: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Banco de dados principal (usado pela aplicação)
DATABASE_URL="postgresql://quimiport:quimiport@localhost:5432/quimiport?schema=public"

# Banco de dados usado pelos testes de integração (nunca aponte para o de produção)
DATABASE_URL_TEST="postgresql://quimiport:quimiport@localhost:5432/quimiport_test?schema=public"

# Credenciais usadas pelo serviço "db" do docker-compose.yml para criar o banco principal
POSTGRES_USER=quimiport
POSTGRES_PASSWORD=quimiport
POSTGRES_DB=quimiport
